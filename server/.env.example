# Core app
JWT_SECRET=change_this_secret
TOKEN_ENCRYPTION_KEY=change_this_32_char_key
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=eduglobal_crm
MONGODB_COLLECTION=app_state
MONGODB_DOCUMENT_ID=default

# Cloudinary storage for images and files
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Meta integration
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v22.0
META_REDIRECT_URI=
META_WEBHOOK_URL=

# Study Birds integration: configure on the CRM server only.
STUDY_BIRDS_ENABLED=false
STUDY_BIRDS_API_URL=https://your-website-api.example/api
STUDY_BIRDS_API_TOKEN=
STUDY_BIRDS_ALLOW_WRITES=false
# Optional CRM-only polling and inbound contact mail relay
STUDY_BIRDS_SYNC_ENABLED=false
STUDY_BIRDS_COMPANY_ID=
STUDY_BIRDS_SYNC_INTERVAL_MS=120000
STUDY_BIRDS_MAIL_SECRET=
